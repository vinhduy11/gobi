// file: x.go
package demo

import (
	"context"
	"sync"
)

// Proxy pattern: https://refactoring.guru/design-patterns/proxy

// Service is implemented by the real subject and by its proxy.
type Service interface {
	Fetch(ctx context.Context, key string) (string, error)
}

// ServiceProxy creates the real Service on first use and forwards to it. Add caching or an access check in the forwarding method.
type ServiceProxy struct {
	once   sync.Once
	load   func() Service
	target Service
}

var _ Service = (*ServiceProxy)(nil)

// NewServiceProxy returns a proxy that calls load once, when the real subject is first needed.
func NewServiceProxy(load func() Service) *ServiceProxy {
	return &ServiceProxy{load: load}
}

// Fetch forwards to the real subject.
func (s *ServiceProxy) Fetch(ctx context.Context, key string) (string, error) {
	s.once.Do(func() { s.target = s.load() })
	return s.target.Fetch(ctx, key)
}
