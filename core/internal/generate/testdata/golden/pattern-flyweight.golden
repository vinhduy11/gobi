// file: x.go
package demo

import "sync"

// Flyweight pattern: https://refactoring.guru/design-patterns/flyweight

// Glyph is the shared, immutable state. Every field must be comparable: the value itself is the pool key.
type Glyph struct {
	char rune
	font string
}

// GlyphPool hands out one shared *Glyph per distinct value. It is safe for concurrent use.
type GlyphPool struct {
	mu    sync.Mutex
	items map[Glyph]*Glyph
}

// NewGlyphPool returns an empty pool.
func NewGlyphPool() *GlyphPool {
	return &GlyphPool{items: make(map[Glyph]*Glyph)}
}

// Get returns the shared Glyph equal to v, creating it on first use.
func (g *GlyphPool) Get(v Glyph) *Glyph {
	g.mu.Lock()
	defer g.mu.Unlock()
	if shared, ok := g.items[v]; ok {
		return shared
	}
	g.items[v] = &v
	return &v
}
