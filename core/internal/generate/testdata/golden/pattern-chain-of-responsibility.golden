// file: x.go
package demo

import "context"

// Chain of Responsibility pattern: https://refactoring.guru/design-patterns/chain-of-responsibility

// Handler is one link of a chain: it reports whether it handled req, and false passes req on to the next link.
type Handler interface {
	Handle(ctx context.Context, req string) bool
}

// HandlerFunc lets an ordinary function be a Handler.
type HandlerFunc func(ctx context.Context, req string) bool

// Handle calls f.
func (f HandlerFunc) Handle(ctx context.Context, req string) bool { return f(ctx, req) }

// HandlerChain tries its links in order until one handles the request.
type HandlerChain []Handler

// Handle reports whether any link handled req.
func (c HandlerChain) Handle(ctx context.Context, req string) bool {
	for _, link := range c {
		if link.Handle(ctx, req) {
			return true
		}
	}
	return false
}
